<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mall</groupId>
        <artifactId>mini-mall</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>mall-gateway</artifactId>
    <name>mall-gateway</name>
    <description>API 网关：统一入口、路由转发、鉴权、限流（L7）</description>

    <dependencies>
        <!-- 公共模块：复用 L6 的 JwtVerifier（验签）、Result、ErrorCode。
             mall-common 里的 spring-boot-starter-web 是 provided，不会传递给网关，
             所以不会把 Servlet/WebMVC 带进这个 WebFlux 应用 -->
        <dependency>
            <groupId>com.mall</groupId>
            <artifactId>mall-common</artifactId>
        </dependency>

        <!-- Spring Cloud Gateway（WebFlux 版，5.x 的构件名带 server-webflux）。
             网关是响应式的，和业务服务的 spring-boot-starter-web 互斥：
             这里绝对不能引 starter-web，否则 WebMVC 和 WebFlux 两个容器同时抢着启动 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>

        <!-- Nacos 服务注册与发现：启动时把 gateway 也登记到 8848。
             父工程没导 SCA BOM，所以版本号必须在这里写 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
            <version>${spring-cloud-alibaba.version}</version>
        </dependency>

        <!-- 客户端负载均衡：路由写 lb://服务名 时，由它把服务名换成 Nacos 里的实例地址 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
